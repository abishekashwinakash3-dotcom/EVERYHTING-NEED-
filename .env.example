# ═══════════════════════════════════════════════════════════════
#  FREE API KEYS  —  copy to .env and fill in what you want
#  cp .env.example .env
#
#  ⚠️  .env is gitignored. NEVER commit real keys.
#  Full guide + ranking + limits: docs/05-free-api-keys.md
# ═══════════════════════════════════════════════════════════════

# ─── TIER 1 — get these first (best free limits, no card) ───

# Google Gemini — most generous free tier overall. Start here.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq — absurdly fast inference, free tier, no card.
# https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — one key, many models; 17 models with a :free suffix.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── TIER 2 — worth adding ───

# Mistral — free tier on by default, ~$10/mo credit, no card.
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# NVIDIA NIM — 100+ models, free with Developer Program. 40 RPM / 10k RPD.
# https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=

# Cohere — 1,000 calls/month, NON-COMMERCIAL USE ONLY (fine for schoolwork).
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Cloudflare Workers AI — 10,000 Neurons/day, 75+ models.
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Hugging Face — thousands of models, small monthly credit.
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ─── SEARCH / SCRAPE (power the MCP servers) ───

# Exa — neural search built for AI agents. Free tier.
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Tavily — search API designed for LLMs. 1,000 free credits/month.
# https://app.tavily.com/home
TAVILY_API_KEY=

# Firecrawl — turn any site into clean markdown. Free tier.
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# ─── BACKEND (side projects) ───

# Supabase — free Postgres + auth + storage. Best free backend for shipping.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ─── AI COUNCIL (docs/07) ───
# The council MCP uses OpenRouter by default — OPENROUTER_API_KEY above is enough.
# Override the panel if you want:
# COUNCIL_MODELS=google/gemini-2.5-pro,deepseek/deepseek-chat,anthropic/claude-sonnet-4
